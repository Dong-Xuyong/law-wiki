---
import "../styles/dong-ui-theme.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: "home" | "search" | "folders" | "map" | "document" | "plan";
  wide?: boolean;
}

const {
  description = "Pesquisa pública no corpus jurídico Law Wiki.",
  current,
  wide = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const currentAttr = (id: Props["current"]) => (current === id ? "page" : undefined);
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("dong-ui-theme");
          var dark = stored === "dark" || (stored !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.style.colorScheme = dark ? "dark" : "light";
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Encode+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/ui/shell.css?v=1" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>Legal Research Wiki</title>
    <script is:inline defer src={`${base}/dong-ui/theme.js`}></script>
  </head>
  <body class:list={["dx", { "map-page": wide }]}>
    <a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>
    <header class="dx-header">
      <a class="dx-home" href="/" aria-label="Home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
      </a>
      <h1 class="dx-title">Legal Research Wiki</h1>
      <div class="dx-actions">
        <button
          type="button"
          class="dong-theme-toggle"
          data-dong-theme-toggle
          data-dong-ready="1"
          role="switch"
          aria-checked="false"
          aria-label="Mudar para modo escuro"
        >
          <span class="dong-theme-toggle__track" aria-hidden="true">
            <svg class="dong-theme-toggle__icon is-active" data-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <svg class="dong-theme-toggle__icon" data-icon="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
            </svg>
            <span class="dong-theme-toggle__knob"></span>
          </span>
        </button>
      </div>
    </header>
    <nav class="dx-tabs" aria-label="Secções">
      <a class="dx-tab" href={href("/")} aria-current={currentAttr("home")}>Início</a>
      <a class="dx-tab" href={href("/search/")} aria-current={currentAttr("search")}>Pesquisar</a>
      <a class="dx-tab" href={href("/folders/")} aria-current={currentAttr("folders")}>Pastas</a>
      <a class="dx-tab" href={href("/map/")} aria-current={currentAttr("map")}>Mapa</a>
      <a class="dx-tab" href={href("/plano/")} aria-current={currentAttr("plan")}>Plano</a>
    </nav>
    <div class="research-notice dx-card">
      Auxiliar de pesquisa — conteúdo importado pode estar não verificado e não constitui aconselhamento jurídico.
    </div>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="dx-on-bg">
      <span>Law Wiki</span>
      <span>Fontes integrais, relações com proveniência e estado de verificação visível. · <a href="https://github.com/Dong-Xuyong/law-wiki">GitHub</a></span>
    </footer>
  </body>
</html>
