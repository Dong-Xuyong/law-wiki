---
import BaseLayout from "../layouts/BaseLayout.astro";
import catalog from "../generated/catalog.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const docs = catalog.documents;
const websites = new Set(docs.map((item) => item.website).filter(Boolean)).size;
const topics = new Set(docs.map((item) => item.topic_raw || item.topic).filter(Boolean)).size;
---

<BaseLayout title="Pesquisa jurídica conectada" current="home">
  <section class="container home-dashboard">
    <div class="corpus-hero">
      <p class="eyebrow">Corpus jurídico público</p>
      <h1>Encontre o documento. Veja as ligações.</h1>
      <p class="lede">
        Pesquise decisões, legislação e materiais jurídicos pelo texto integral.
        Navegue pela estrutura original de pastas ou explore autoridades, temas e fontes num mapa interativo.
      </p>
      <div class="status-stats">
        <div class="stat"><strong>{catalog.count.toLocaleString("pt-PT")}</strong><span>documentos pesquisáveis</span></div>
        <div class="stat"><strong>{websites}</strong><span>fontes institucionais</span></div>
        <div class="stat"><strong>{topics}</strong><span>temas de arquivo</span></div>
      </div>
      <form class="search-box hero-search" action={`${base}/search/`}>
        <input name="q" type="search" placeholder="Ex.: compensação por cancelamento de voo" aria-label="Pesquisar no corpus" />
        <button type="submit">Pesquisar</button>
      </form>
    </div>

    <section class="home-section" aria-labelledby="explorar-titulo">
      <div class="section-heading">
        <p class="eyebrow">Explorar o arquivo</p>
        <h2 id="explorar-titulo">Pastas e mapa</h2>
      </div>
      <div class="category-list">
        <a class="category-row" href={`${base}/folders/`}>
          <span class="category-icon" style="--row-color: var(--forest)"></span>
          <span class="category-row-main">
            <span class="category-row-title">Explorar pastas</span>
            <span class="category-row-count">{websites} fontes institucionais no arquivo original</span>
          </span>
          <span class="category-chevron" aria-hidden="true">›</span>
        </a>
        <a class="category-row" href={`${base}/map/`}>
          <span class="category-icon" style="--row-color: var(--gold)"></span>
          <span class="category-row-main">
            <span class="category-row-title">Mapa jurídico</span>
            <span class="category-row-count">{topics} temas de arquivo e relações aceites</span>
          </span>
          <span class="category-chevron" aria-hidden="true">›</span>
        </a>
      </div>
    </section>

    <section class="home-section explainer-section" aria-labelledby="llm-titulo">
      <div class="section-heading">
        <p class="eyebrow">Do corpus à resposta</p>
        <h2 id="llm-titulo">Como funciona um LLM jurídico</h2>
      </div>
      <figure class="llm-infographic">
        <a
          href={`${base}/images/how-a-legal-llm-works.png`}
          target="_blank"
          rel="noreferrer"
          aria-label="Abrir o infográfico em tamanho completo"
        >
          <img
            src={`${base}/images/how-a-legal-llm-works.png`}
            alt="Infográfico em português sobre oito etapas de um LLM jurídico: fontes, ingestão, indexação, pergunta, recuperação de autoridades, análise do contexto, resposta fundamentada e verificação humana."
            width="1024"
            height="576"
            loading="lazy"
            decoding="async"
          />
        </a>
        <figcaption>
          Uma resposta fiável combina fontes autorizadas, recuperação com citações e verificação humana.
          <a href={`${base}/images/how-a-legal-llm-works.png`} target="_blank" rel="noreferrer">
            Abrir em tamanho completo
          </a>
        </figcaption>
      </figure>
    </section>

    <section class="home-section explainer-section" aria-labelledby="law-wiki-titulo">
      <div class="section-heading">
        <p class="eyebrow">Do registo à minuta</p>
        <h2 id="law-wiki-titulo">Como funciona o /law-wiki</h2>
      </div>
      <figure class="llm-infographic">
        <a
          href={`${base}/images/como-funciona-law-wiki-skill.png`}
          target="_blank"
          rel="noreferrer"
          aria-label="Abrir o infográfico do fluxo /law-wiki em tamanho completo"
        >
          <img
            src={`${base}/images/como-funciona-law-wiki-skill.png`}
            alt="Infográfico em oito etapas sobre o fluxo /law-wiki, desde o registo do caso e a pesquisa no corpus local até à minuta arbitral não assinada, validação e revisão humana."
            width="1024"
            height="576"
            loading="lazy"
            decoding="async"
          />
        </a>
        <figcaption>
          O /law-wiki separa factos de direito, pesquisa apenas no corpus local e produz uma minuta não oficial para revisão humana.
          <a href={`${base}/images/como-funciona-law-wiki-skill.png`} target="_blank" rel="noreferrer">
            Abrir em tamanho completo
          </a>
        </figcaption>
      </figure>
    </section>

    <section class="panel research-card">
      <p class="eyebrow">Como ler o portal</p>
      <h2>Fonte primeiro, análise depois</h2>
      <p class="lede">
        Cada resultado conserva o caminho original, metadados e estado de verificação.
        Abra o texto integral antes de tratar um resumo importado como fundamento jurídico.
      </p>
    </section>
  </section>
</BaseLayout>
