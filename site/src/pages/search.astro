---
import BaseLayout from "../layouts/BaseLayout.astro";
import catalog from "../generated/catalog.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const unique = (key: "website" | "year" | "topic_raw") =>
  [...new Set(catalog.documents.map((item) => String(item[key] || "")).filter(Boolean))]
    .sort((a, b) => a.localeCompare(b, "pt"));
---

<BaseLayout title="Pesquisa" current="search">
  <section class="container">
    <p class="eyebrow">Pesquisa integral</p>
    <h1>Pesquisar no corpus</h1>
    <form id="search-form" class="search-box">
      <input id="query" type="search" placeholder="Termos, processo, artigo, tribunal…" aria-label="Termos de pesquisa" />
      <button type="submit">Pesquisar</button>
    </form>
    <div class="filters">
      <select id="website" aria-label="Filtrar por fonte">
        <option value="">Todas as fontes</option>
        {unique("website").map((value) => <option value={value}>{value}</option>)}
      </select>
      <select id="year" aria-label="Filtrar por ano">
        <option value="">Todos os anos</option>
        {unique("year").map((value) => <option value={value}>{value}</option>)}
      </select>
      <select id="topic" aria-label="Filtrar por tema">
        <option value="">Todos os temas</option>
        {unique("topic_raw").map((value) => <option value={value}>{value}</option>)}
      </select>
    </div>
    <p id="search-status" class="status">Introduza termos para pesquisar títulos, resumos e texto integral.</p>
    <div id="results" class="results" aria-live="polite"></div>
  </section>

  <script is:inline define:vars={{ base }}>
    const form = document.querySelector("#search-form");
    const input = document.querySelector("#query");
    const status = document.querySelector("#search-status");
    const results = document.querySelector("#results");
    const selectors = {
      website: document.querySelector("#website"),
      year: document.querySelector("#year"),
      topic: document.querySelector("#topic"),
    };

    const escapeHtml = (value) => {
      const node = document.createElement("span");
      node.textContent = value || "";
      return node.innerHTML;
    };

    async function runSearch() {
      const query = input.value.trim();
      const params = new URLSearchParams(location.search);
      if (query) params.set("q", query); else params.delete("q");
      history.replaceState({}, "", `${location.pathname}${params.size ? `?${params}` : ""}`);
      if (!query) {
        results.innerHTML = "";
        status.textContent = "Introduza termos para pesquisar títulos, resumos e texto integral.";
        return;
      }
      status.textContent = "A pesquisar…";
      try {
        const pagefind = await import(`${base}/pagefind/pagefind.js`);
        await pagefind.init();
        const filters = {};
        for (const [key, selector] of Object.entries(selectors)) {
          if (selector.value) filters[key] = selector.value;
        }
        const search = await pagefind.search(query, { filters });
        const pages = await Promise.all(search.results.slice(0, 100).map((item) => item.data()));
        status.textContent = `${search.results.length.toLocaleString("pt-PT")} resultado(s)${search.results.length > 100 ? " — apresentados os primeiros 100" : ""}.`;
        results.innerHTML = pages.map((page) => `
          <article class="result">
            <h3><a href="${page.url}">${escapeHtml(page.meta.title)}</a></h3>
            <p>${page.excerpt || ""}</p>
            <span class="tag">${escapeHtml(page.meta.website || "Fonte desconhecida")}</span>
            <span class="tag">${escapeHtml(page.meta.year || "Ano desconhecido")}</span>
            <span class="tag warning">${escapeHtml(page.meta.verification || "unverified")}</span>
          </article>
        `).join("");
      } catch (error) {
        status.textContent = "O índice de pesquisa ainda não está disponível. Execute a compilação completa do portal.";
        console.error(error);
      }
    }

    form.addEventListener("submit", (event) => { event.preventDefault(); runSearch(); });
    Object.values(selectors).forEach((selector) => selector.addEventListener("change", runSearch));
    const initial = new URLSearchParams(location.search).get("q") || "";
    input.value = initial;
    if (initial) runSearch();
  </script>
</BaseLayout>
