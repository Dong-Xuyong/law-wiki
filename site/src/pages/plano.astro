  <script is:inline src={`${base}/dong-ui/gh-sync.js`}></script>
  <script is:inline define:vars={{ base }}>
    const loadButton = document.querySelector("#progresso-carregar");
    const statusLine = document.querySelector("#progresso-estado");
    const output = document.querySelector("#progresso-conteudo");

    const STATUS_LABELS = {
      todo: "Por fazer",
      in_progress: "Em curso",
      blocked: "Bloqueada",
      done: "Concluída",
    };
    const OWNER_LABELS = {
      dong: "Dong",
      juiza: "Juíza",
      grokbot: "Grokbot",
    };

    const node = (tag, className, text) => {
      const element = document.createElement(tag);
      if (className) element.className = className;
      if (text != null && text !== "") element.textContent = String(text);
      return element;
    };

    const labelOf = (map, value) => {
      if (value != null && Object.prototype.hasOwnProperty.call(map, value)) return map[value];
      return value == null ? "" : String(value);
    };

    const statusClass = (status) => (status === "blocked" ? "tag warning" : "tag");

    const formatWhen = (value) => {
      if (!value) return "";
      const text = String(value);
      const day = /^(\d{4})-(\d{2})-(\d{2})$/.exec(text);
      if (day) {
        const date = new Date(Number(day[1]), Number(day[2]) - 1, Number(day[3]));
        return new Intl.DateTimeFormat("pt-PT", { dateStyle: "long" }).format(date);
      }
      const date = new Date(text);
      if (Number.isNaN(date.getTime())) return text;
      return new Intl.DateTimeFormat("pt-PT", { dateStyle: "long", timeStyle: "short" }).format(date);
    };

    const safeHttpUrl = (url) => {
      if (typeof url !== "string") return "";
      if (!url.startsWith("http://") && !url.startsWith("https://")) return "";
      try {
        const parsed = new URL(url);
        if (parsed.protocol !== "http:" && parsed.protocol !== "https:") return "";
        return parsed.href;
      } catch (error) {
        return "";
      }
    };

    const active = (items) => (Array.isArray(items) ? items.filter((item) => item && item.deleted !== true) : []);

    function render(data) {
      output.replaceChildren();
      if (!data || typeof data !== "object") return;

      if (data.updatedAt) {
        output.appendChild(node("p", "status", `Atualizado em ${formatWhen(data.updatedAt)}`));
      }

      const tasks = active(data.tasks);
      const phases = active(data.phases).map((phase, index) => ({ phase, index }));
      phases.sort((a, b) => {
        const left = /^fase-(\d+)$/.exec(a.phase.id || "");
        const right = /^fase-(\d+)$/.exec(b.phase.id || "");
        if (left && right && left[1] !== right[1]) return Number(left[1]) - Number(right[1]);
        return a.index - b.index;
      });

      if (phases.length) {
        const list = node("ol", "plan-progress-phases");
        phases.forEach(({ phase }) => {
          const item = node("li", "panel");
          const head = node("div", "plan-progress-head");
          head.append(
            node("h3", null, phase.title || phase.id || "Fase"),
            node("span", statusClass(phase.status), labelOf(STATUS_LABELS, phase.status)),
          );
          item.appendChild(head);

          const phaseTasks = tasks.filter((task) => task.phaseId === phase.id);
          const done = phaseTasks.filter((task) => task.status === "done").length;
          item.appendChild(node("p", "plan-progress-count", `${done}/${phaseTasks.length} tarefas concluídas`));

          const gate = node("p", "plan-progress-gate");
          gate.appendChild(node("strong", null, "Critério: "));
          if (phase.gate) gate.appendChild(document.createTextNode(`${String(phase.gate)} `));
          gate.appendChild(node("span", phase.gateMet ? "tag" : "tag warning", phase.gateMet ? "Cumprido" : "Por cumprir"));
          item.appendChild(gate);

          if (phaseTasks.length) {
            const taskList = node("ul", "plan-progress-tasks");
            phaseTasks.forEach((task) => {
              const row = node("li");
              row.append(
                node("span", statusClass(task.status), labelOf(STATUS_LABELS, task.status)),
                node("span", "plan-progress-task-title", task.title || task.id || "Tarefa"),
              );
              const metaParts = [];
              if (task.owner) metaParts.push(labelOf(OWNER_LABELS, task.owner));
              if (task.due) metaParts.push(`prazo ${formatWhen(task.due)}`);
              if (metaParts.length) row.appendChild(node("span", "plan-progress-meta", metaParts.join(" · ")));
              const linkRow = node("span", "plan-progress-links");
              (Array.isArray(task.links) ? task.links : []).forEach((link) => {
                const href = safeHttpUrl(link && link.url);
                if (!href) return;
                const rawLabel = link && typeof link.label === "string" ? link.label.trim() : "";
                const anchor = node("a", null, rawLabel || href);
                anchor.href = href;
                anchor.rel = "noopener noreferrer";
                anchor.target = "_blank";
                linkRow.appendChild(anchor);
              });
              if (linkRow.childNodes.length) row.appendChild(linkRow);
              taskList.appendChild(row);
            });
            item.appendChild(taskList);
          }
          list.appendChild(item);
        });
        output.appendChild(list);
      }

      const decisions = active(data.decisions);
      [
        ["Decisões em aberto", decisions.filter((item) => item.status === "open"), false],
        ["Decisões tomadas", decisions.filter((item) => item.status === "decided"), true],
      ].forEach(([title, items, withAnswer]) => {
        if (!items.length) return;
        const block = node("div", "plan-progress-block");
        block.appendChild(node("h3", null, title));
        const list = node("ul", "plan-progress-decisions");
        items.forEach((item) => {
          const row = node("li");
          row.appendChild(node("strong", null, item.question || ""));
          if (withAnswer && item.answer) row.appendChild(node("p", "plan-progress-note", item.answer));
          list.appendChild(row);
        });
        block.appendChild(list);
        output.appendChild(block);
      });

      const questionnaire = data.questionnaire;
      if (questionnaire && typeof questionnaire === "object") {
        const block = node("div", "panel plan-progress-block");
        block.appendChild(node("h3", null, "Questionário"));
        const count = Number(questionnaire.responseCount);
        const countText = Number.isFinite(count) ? count.toLocaleString("pt-PT") : "0";
        const noun = count === 1 ? "resposta" : "respostas";
        const checked = questionnaire.lastCheckedAt ? formatWhen(questionnaire.lastCheckedAt) : "sem data";
        block.appendChild(node("p", null, `${countText} ${noun}. Última verificação: ${checked}.`));
        output.appendChild(block);
      }

      const entries = active(data.log)
        .slice()
        .sort((a, b) => {
          const right = new Date(b.at).getTime();
          const left = new Date(a.at).getTime();
          return (Number.isNaN(right) ? 0 : right) - (Number.isNaN(left) ? 0 : left);
        })
        .slice(0, 10);
      if (entries.length) {
        const block = node("div", "plan-progress-block");
        block.appendChild(node("h3", null, "Registo"));
        const list = node("ol", "plan-progress-log");
        entries.forEach((entry) => {
          const row = node("li");
          const time = node("time", "plan-progress-meta", formatWhen(entry.at));
          if (entry.at) time.dateTime = String(entry.at);
          row.append(time, document.createTextNode(entry.text ? ` ${entry.text}` : ""));
          list.appendChild(row);
        });
        block.appendChild(list);
        output.appendChild(block);
      }
    }

    const setStatus = (message) => {
      statusLine.textContent = message || "";
    };

    const loadProgress = () => {
      if (!window.GhSync || typeof window.GhSync.load !== "function") {
        setStatus("O carregamento de progresso não está disponível.");
        return;
      }
      setStatus("A carregar…");
      loadButton.disabled = true;
      window.GhSync
        .load("law-wiki-plan", render)
        .then((message) => setStatus(message || ""))
        .catch((error) => setStatus(error && error.message ? error.message : "Não foi possível carregar o progresso."))
        .finally(() => {
          loadButton.disabled = false;
        });
    };

    loadButton.addEventListener("click", loadProgress);

    const hasStoredToken = () => {
      try {
        const raw = localStorage.getItem("dong-gh-sync");
        if (!raw) return false;
        const config = JSON.parse(raw);
        return Boolean(config && typeof config.token === "string" && config.token.trim());
      } catch (error) {
        return false;
      }
    };

    if (hasStoredToken()) loadProgress();
  </script>
</BaseLayout>

